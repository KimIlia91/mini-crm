{
  "name": "mini-crm",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint src tests scripts \"*.{js,ts}\" --max-warnings=0",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write src tests scripts supabase .github \"*.{json,ts,js,md,html}\"",
    "format:check": "prettier --check src tests scripts supabase .github \"*.{json,ts,js,md,html}\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "audit": "npm audit --audit-level=moderate",
    "check:static": "npm run -s typecheck && npm run -s lint && npm run -s lint:fsd",
    "check": "npm run -s check:static && npm run -s format:check && npm run -s test",
    "verify": "npm run -s check && npm run -s build && npm run -s db:lint && npm run -s test:db && npm run -s test:integration && npm run -s test:e2e && npm run -s audit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning --fail-on warning",
    "db:types": "supabase gen types --lang typescript > src/shared/api/database.types.ts && prettier --write src/shared/api/database.types.ts",
    "db:status": "node scripts/supabase-env.mjs status",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "env:local": "node scripts/supabase-env.mjs env-local"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-table": "^9.2.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "~26.5.6",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "~17.1.3",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.65.0",
    "@tanstack/eslint-plugin-query": "^5.106.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "steiger": "^0.9.0",
    "supabase": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
