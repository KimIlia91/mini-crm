# Normalize line endings: LF in the repository and in every checkout, regardless of
# core.autocrlf (Prettier enforces LF; CRLF checkouts would fail `npm run format:check`).
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
